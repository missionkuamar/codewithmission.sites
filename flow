Step 6-7: Backend Verifies Token (Backend)
javascript
// backend/controllers/authController.js
const verifyGoogleToken = async (credential) => {
  // Google ke servers se verify karate hain token
  const ticket = await googleClient.verifyIdToken({
    idToken: credential,
    audience: GOOGLE_CLIENT_ID,
  });
  
  // Token valid hai to user data milta hai
  const payload = ticket.getPayload();
  // payload contains:
  // {
  //   sub: "123456789", (Google ID)
  //   email: "user@gmail.com",
  //   name: "John Doe",
  //   picture: "https://...",
  //   email_verified: true
  // }
}
Step 8-10: Database Operations (MongoDB)
javascript
// Check if user already exists
let user = await User.findOne({ email: googleUser.email });

if (user) {
  // CASE 1: LOGIN - User already registered
  user.lastLogin = Date.now();
  user.name = googleUser.name;
  await user.save();
  // Welcome back message
} else {
  // CASE 2: REGISTER - First time user
  user = await User.create({
    googleId: googleUser.googleId,
    email: googleUser.email,
    name: googleUser.name,
    picture: googleUser.picture,
    // Create username from email
    username: generateUsername(googleUser.email)
  });
  // Welcome new user message
}
Step 11: Generate JWT Token
javascript
// backend/utils/generateToken.js
const generateToken = (userId) => {
  // JWT = JSON Web Token
  // Yeh ek secure string hai jisme user info hoti hai
  return jwt.sign(
    { userId: userId },     // Payload - data jo store karna hai
    process.env.JWT_SECRET, // Secret key - only server knows
    { expiresIn: '30d' }    // Token 30 days tak valid
  );
};

// Example token:
// "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiI2NzEyMzQ1Njc4OTAiLCJpYXQiOjE3MTYyMzkwMjJ9.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
